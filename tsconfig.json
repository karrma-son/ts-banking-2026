{
    "compilerOptions": {
        "types": [
            "node"
        ],
        "target": "ES2022",
        "module": "CommonJS",
        "rootDir": "./",
        "outDir": "./dist",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "moduleResolution": "bundler"
    },
    "include": [
        "src/**/*"
    ]
}